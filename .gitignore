# FedScope raw download cache — large (~1 GB unzipped). Re-create with
# `python src/fetch_fedscope.py`. The extracted economist CSVs are committed.
data/raw/fedscope/_downloads/

# Python
__pycache__/
*.pyc

# Aggregated all-occupation panels (rebuild with: python src/build_panels.py)
data/processed/panels/

# Monthly data.opm.gov downloads (~41 GB, hand-downloaded) and their derived panels
data/raw/opm_datasets/
# (the small derived tables in data/processed/fwd/ ARE committed; only scratch parts are ignored)
data/processed/fwd/_parts/
data/processed/fwd/*.log
